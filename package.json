        "mermaid": "^12.3.0",
        "next-themes": "^0.4.6",
        "parse5": "^8.1.0",
        "pg": "^8.23.1",
        "posthog-node": "^5.63.0",
        "property-information": "^7.2.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "rehype-sanitize": "^6.0.0",
        "remark": "^15.0.1",
        "remark-gfm": "^4.0.1",
        "remark-mdx": "^3.1.1",
        "remark-rehype": "^11.1.2",
        "satori": "^0.63.2",
