{
    "name": "@maniculehq/margin",
    "version": "0.0.0",
    "private": false,
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./ingest": "./src/ingest/index.ts",
        "./ingest/*": "./src/ingest/*.ts",
        "./db": "./src/db/index.ts",
        "./db/schema": "./src/db/schema/index.ts",
        "./types/*": "./src/types/*.ts",
        "./extensions/types": "./src/extensions/types.ts",
        "./vite-plugins": "./vite-plugins.ts",
        "./package.json": "./package.json"
    },
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "bun --env-file=.env scripts/dev.ts",
        "build": "bun run icons:build && vite build",
        "vercel-build": "bun scripts/vercel-build.ts",
        "start": "bun --env-file=.env x vite preview",
        "typecheck": "bun run icons:build && tsc --noEmit",
        "test": "vitest run",
        "test:db": "docker compose up -d --wait postgres && bun run db:migrate && bun --env-file=.env x vitest run",
        "test:e2e": "bun scripts/e2e.ts",
        "ingest": "bun --env-file=.env scripts/ingest.ts",
        "ingest:watch": "bun --env-file=.env scripts/ingest.ts --watch",
        "icons:build": "bun scripts/build-icon-map.ts",
        "fonts:subset": "bun scripts/subset-fonts.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "bun --env-file=.env scripts/db-migrate.ts",
        "lint": "biome ci .",
        "check-deps": "bun scripts/check-deps.ts",
        "check-licenses": "bun scripts/check-licenses.ts",
        "doctor": "bun scripts/doctor.ts"
    },
    "dependencies": {
        "@ai-sdk/gateway": "^4.0.136",
        "@ai-sdk/otel": "^1.0.163",
