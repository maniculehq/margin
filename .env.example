# Copy to .env and fill in what you need. Only the database URL is required.
# `bun run dev`, `start`, `db:migrate`, `ingest` and `test:db` load this file;
# `bun run test` and other commands ignore it.

# Postgres connection string; DATABASE_URL wins, POSTGRES_URL is the fallback (Neon sets both).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5440/docs
# POSTGRES_URL=
# Direct (non-pooled) URL for migrations; defaults to the pooled URL.
# DATABASE_URL_UNPOOLED=
# POSTGRES_URL_NON_POOLING=
# Connection pool size per server instance (default 2).
# DATABASE_POOL_MAX=2
# Host port of the docker compose Postgres (default 5440); keep DATABASE_URL in step.
# POSTGRES_PORT=5440
# Remote databases are reached over TLS with the certificate verified against
# Node's built-in CA list. A provider signing with a private CA: point Node at
# its CA bundle (read once at process start, so set it in the environment the
# server, `db:migrate` and `ingest` run in, not only in this file).
# NODE_EXTRA_CA_CERTS=/path/to/provider-ca.pem

# Public origin for canonicals, sitemaps and OG images; required off Vercel.
SITE_ORIGIN=http://localhost:3000
# Site slug stored in docs_site.slug and used as the cache tag (default docs).
# SITE_SLUG=docs
# Display name; defaults to docs.json `name`, then the slug.
# SITE_NAME=

# Folder holding docs.json and the MDX pages (default docs, else the repo root).
# DOCS_DIR=docs
# Content version key; defaults to VERCEL_GIT_COMMIT_SHA, then git HEAD, then dev-<ms>.
# DOCS_CONTENT_SHA=
# Build-time ingest: on (default), off to skip, force to re-ingest an existing SHA.
# DOCS_INGEST=on
# Content versions kept before garbage collection (default 20).
# DOCS_KEEP_VERSIONS=20
# 1 (default) redirects production requests to the SITE_ORIGIN host with a 308.
# DOCS_CANONICAL_REDIRECT=1
# AI Gateway model slug for the docs assistant.
# DOCS_CHAT_MODEL=openai/gpt-5.6-terra
# AI Gateway key; on Vercel OIDC is used instead. Without either the assistant is off.
# AI_GATEWAY_API_KEY=
# Base URL for the link relations in discovery Link headers.
# DOCS_LINK_RELATION_BASE=

# Optional Hugeicons Pro token for `bun run icons:build`; without it the free set is used.
# HUGEICONS_PRO_TOKEN=
# Hugeicons Pro style used when a token is set (default stroke-rounded).
# HUGEICONS_PRO_STYLE=stroke-rounded

# Vercel Blob token; assets over 1 MB and the search corpus are stored there.
# BLOB_READ_WRITE_TOKEN=
# GitHub token to lift the rate limit of the repository stars widget.
# GITHUB_TOKEN=

# Sentry; off without a DSN. Source-map upload needs org, project and auth token.
# Local development stays silent even with a DSN unless SENTRY_ENVIRONMENT is
# set (e.g. SENTRY_ENVIRONMENT=development to debug instrumentation).
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# SENTRY_ENVIRONMENT=
# SENTRY_RELEASE=

# PostHog agent-journey analytics; off without a key.
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# Build-time path to a module implementing DocsExtensions; defaults to the built-in single-site one.
# DOCS_EXTENSIONS=

# Runtime: Nitro preset (default vercel), port, and environment flags.
# NITRO_PRESET=vercel
# PORT=3000
# NODE_ENV=development
# VERCEL_ENV=
